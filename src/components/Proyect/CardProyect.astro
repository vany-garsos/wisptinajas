---
import { Icon } from "astro-icon/components";
import LinkButton from "./LinkButton.astro";
import Badge from "../UI/Badge.astro";

interface Props {
    title: string;
    price: number;
    subida: string;
    descarga:string;
    folio:number;
    color: string;
    bgColor: string;
    tags: Array<{
        name: string;
        class: string;
        icon: string;
    }>;
}

const { title, price, subida, descarga, folio, color, bgColor, tags } = Astro.props;
---
<article
  class="group max-w-sm mx-auto overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-xl"
  data-aos="fade-up"
>
  <!-- Nombre del plan -->
  <div class={`${bgColor} py-4 px-4 text-center`}>
    <h3 class="text-xl font-bold tracking-wide text-white">
      {title}
    </h3>
  </div>

  <div class="p-6">
    <!-- Precio -->
    <div class="text-center">
    <p class={`text-5xl font-black ${color} leading-none`}>
  ${price}<sup class="ml-1 text-lg align-super">*</sup>
</p>

      <p class="mt-2 text-xs uppercase tracking-widest text-gray-500">
        Pago mensual
      </p>
    </div>

    <!-- Separador -->
    <div class="my-5 h-px bg-gray-200"></div>

<!-- Beneficios -->
<ul class="space-y-3 mb-6">

 


  <!-- Tags -->
  {
    tags?.map((tag) => (
      <li class="flex items-center gap-3 text-gray-700">

        <div class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${bgColor}/20`}>
          <Icon 
            name={tag.icon} 
            class={`h-4 w-4 ${color}`}
          />
        </div>

        <span class="text-sm font-medium">
          {tag.name}
        </span>

      </li>
    ))
  }

   <!-- Velocidad descarga -->
  <li class="flex items-center gap-3 text-gray-700">
    <div class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${bgColor}/20`}>
      <Icon 
        name="lucide:download" 
        class={`h-4 w-4 ${color}`}
      />
    </div>

    <span class="text-sm font-medium">
      {descarga}
    </span>
  </li>


  <!-- Velocidad subida -->
  <li class="flex items-center gap-3 text-gray-700">
    <div class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${bgColor}/20`}>
      <Icon 
        name="lucide:upload" 
        class={`h-4 w-4 ${color}`}
      />
    </div>

    <span class="text-sm font-medium">
      {subida}
    </span>
  </li>

  <!-- Folio IFT -->
<li class="flex items-center gap-3 text-gray-700">
  <div class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${bgColor}/20`}>
    <Icon 
      name="lucide:file-text" 
      class={`h-4 w-4 ${color}`}
    />
  </div>

  <span class="text-sm font-medium">
    Número de inscripción IFT: {folio}
  </span>
</li>

</ul>

    <!-- Botón -->
    <a
      href="#contacto"
      class={`block w-full text-center ${bgColor} text-white font-semibold py-3 rounded-xl hover:opacity-80 transition`}
    >
      Contacto
    </a>
  </div>
</article>
