---
import Title from "../UI/Title.astro";
import { WIPS } from "../../data/personal";
---

<header
  id="inicio"
  class="relative h-screen flex flex-col items-center justify-center text-center px-4 mt-18 lg:mt-0"
>
<main class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-10">
  <div class="max-w-xl">
    <Title level={2} animate={true}>
      {WIPS.name}
    </Title>

    <p class="text-lg md:text-2xl text-white mb-8 font-medium">
      {WIPS.heroDescription}
    </p>

    <a
      href="#plan"
      class="px-6 py-3 bg-primary hover:bg-secondary text-white font-semibold rounded-3xl transition-all duration-150
      drop-shadow-[2px_2px_0_#0debd8] active:translate-0.5 active:drop-shadow-none"
    >
      Ver planes de Servicio
    </a>
  </div>

  <div class="flex justify-center">
    <img
      src="/images/heroImag.png"
      alt="portrait"
      class="rounded-2xl w-full max-w-sm object-cover"
    />
  </div>
</main>
</header>
