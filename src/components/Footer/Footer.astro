---
import { Icon } from "astro-icon/components";
---
<footer class="py-12 border-t border-white/5 bg-gray-950/50 backdrop-blur-sm">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col items-center justify-center gap-6 text-center">
      
      <!-- Copyright -->
      <p class="text-gray-400 text-sm md:text-base">
        © 2026 Todos los derechos reservados
        <span class="text-white font-medium">
          WISP Tinajas
        </span>
      </p>

      <!-- Enlaces -->
      <div class="flex items-center gap-8">
        <a
          href="/docs/Aviso de Privacidad - WISP TINAJAS.pdf"
          target="_blank"
          class="flex items-center gap-2 text-gray-400 hover:text-[#647EF5] transition-colors text-sm"
        >
          <Icon
            name="lucide:shield-check"
            class="size-4"
          />
          <span>Aviso de Privacidad</span>
        </a>

        <a
          href="https://www.facebook.com/profile.php?id=61587046265568"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-gray-400 hover:text-[#647EF5] transition-colors text-sm"
        >
          <Icon
            name="lucide:facebook"
            class="size-5"
          />
          <span>Facebook</span>
        </a>
      </div>

      <!-- Línea decorativa -->
      <div class="w-24 h-px bg-[#647EF5]/30"></div>

    </div>
  </div>
</footer>