---
import { WIPS } from "../../data/personal";
import Section from "../UI/Section.astro";
import Badge from "../UI/Badge.astro";
---

<Section id="nosotros" title="Acerca de nosotros">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <!-- Photo Column -->
        <div
            class="relative group mx-auto drop-shadow-[8px_8px_0_#647ef5]"
            data-aos="fade-right"
        >
            <div class="absolute -inset-1 rounded-2xl"></div>
            <div class="relative">
                <img
                    src="/images/quienessomos.jpg"
                    alt={`${WIPS.name}`}
                    class="rounded-2xl w-full max-w-md object-cover"
                />
            </div>
        </div>

        <!-- Description Column -->
        <div class="flex flex-col gap-6" data-aos="fade-left">
            <p
                class="text-lg md:text-xl text-gray-300 leading-relaxed font-light"
                set:html={WIPS.description}
            >
                
            </p>
            <div class="flex flex-wrap gap-4 mt-4">
                {
                    WIPS.skills &&
                        WIPS.skills.map((skill) => (
                            <Badge class="px-4 py-2 bg-white/5 text-sm text-gray-400">
                                {skill}
                            </Badge>
                        ))
                }
            </div>
        </div>
    </div>
</Section>
