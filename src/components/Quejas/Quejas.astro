---
import Section from "../UI/Section.astro";
---

<Section id="complaints" title="Quejas y Sugerencias">
  <div class="mx-auto max-w-5xl">
    <div
      class="rounded-3xl border border-white/10 bg-gray-900/60 p-8 shadow-xl"
    >
      <!-- Botones -->
      <div
        class="mx-auto flex w-full max-w-md rounded-2xl border border-white/10 bg-black/40 p-1"
      >
        <button
          id="btnRegister"
          type="button"
          class="flex-1 rounded-xl bg-primary px-4 py-3 font-semibold text-white transition"
        >
          Registrar queja
        </button>

        <button
          id="btnSearch"
          type="button"
          class="flex-1 rounded-xl px-4 py-3 font-semibold text-gray-300 transition hover:text-white"
        >
          Consultar folio
        </button>
      </div>

      <!-- ================= REGISTRO ================= -->

      <div id="registerSection" class="mt-10">
        <h3 class="text-center text-2xl font-semibold text-white">
          Registrar una queja o sugerencia
        </h3>

        <p class="mx-auto mt-3 max-w-3xl text-center text-sm text-gray-400">
          Completa el siguiente formulario. Al finalizar se generará un número
          de folio con el que podrás consultar el estado de tu solicitud.
        </p>

        <form id="complaintsForm" class="mt-10 grid gap-6 md:grid-cols-2">
          <div>
            <label class="mb-2 block text-sm text-gray-300">
              Nombre completo del titular del servicio
            </label>

            <input
              name="nombre"
              type="text"
              required
              maxlength="120"
              placeholder="Ingresa tu nombre"
              class="w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-primary"
            />
          </div>

          <div>
            <label class="mb-2 block text-sm text-gray-300">
              Correo electrónico
            </label>

            <input
              name="correo"
              type="email"
              required
              maxlength="120"
              placeholder="correo@ejemplo.com"
              class="w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-primary"
            />
          </div>

          <div>
            <label class="mb-2 block text-sm text-gray-300"> Teléfono </label>

            <input
              name="telefono"
              type="tel"
              placeholder="7671234567"
              class="w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-primary"
            />
          </div>

          <div>
            <label class="mb-2 block text-sm text-gray-300">
              Tipo de solicitud
            </label>

            <select
              name="tipo"
              required
              class="w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-white outline-none transition focus:border-primary"
            >
              <option value="">Selecciona una opción</option>
              <option value="Queja">Queja</option>
              <option value="Sugerencia">Sugerencia</option>
            </select>
          </div>

          <div class="md:col-span-2">
            <label class="mb-2 block text-sm text-gray-300"> Asunto </label>

            <input
              name="asunto"
              type="text"
              required
              maxlength="200"
              placeholder="Asunto"
              class="w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-primary"
            />
          </div>

          <div class="md:col-span-2">
            <label class="mb-2 block text-sm text-gray-300">
              Descripción
            </label>

            <textarea
              name="descripcion"
              rows="6"
              required
              maxlength="3000"
              placeholder="Describe detalladamente tu queja o sugerencia..."
              class="w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-primary"
            ></textarea>
          </div>

          <div
            class="md:col-span-2 rounded-2xl border border-primary/30 bg-primary/10 p-5"
          >
            <p class="text-sm text-gray-300">
              Una vez enviada tu solicitud, recibirás un
              <span class="font-semibold text-white">número de folio</span>
              único. <span class="font-semibold text-white"
                >Conserva este folio</span
              >, pues lo necesitarás para consultar el estado y dar seguimiento
              a tu solicitud.
            </p>
          </div>

          <div class="md:col-span-2 text-center">
            <button
              type="submit"
              class="rounded-xl bg-primary px-8 py-3 font-semibold text-white transition hover:opacity-90"
            >
              Enviar solicitud
            </button>
          </div>
        </form>
      </div>

      <!-- ================= CONSULTA ================= -->

      <div id="searchSection" class="mt-10 hidden">
        <h3 class="text-center text-2xl font-semibold text-white">
          Consultar estado de una solicitud
        </h3>

        <p class="mx-auto mt-3 max-w-3xl text-center text-sm text-gray-400">
          Ingresa el número de folio que recibiste al registrar tu queja o
          sugerencia.
        </p>

        <form id="searchForm" class="mx-auto mt-10 max-w-xl">
          <label class="mb-2 block text-sm text-gray-300">
            Número de folio
          </label>

          <input
            name="folio"
            type="text"
            required
            placeholder="Ej. Q-20260710-0001"
            class="w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-primary"
          />

          <button
            type="submit"
            class="mt-6 w-full rounded-xl bg-primary py-3 font-semibold text-white transition hover:opacity-90"
          >
            Consultar folio
          </button>
        </form>

        <!-- Resultado -->

        <div
          id="searchResult"
          class="mx-auto mt-10 hidden max-w-xl rounded-2xl border border-white/10 bg-black/30 p-6"
        >
          <h4 class="text-lg font-semibold text-white">
            Resultado de la consulta
          </h4>

          <div class="mt-6 space-y-4">
            <div>
              <p class="text-sm text-gray-400">Folio</p>
              <p id="folioResult" class="font-mono text-white"></p>
            </div>

            <div>
              <p class="text-sm text-gray-400">Tipo</p>
              <p id="tipoResult" class="text-white"></p>
            </div>

            <div>
              <p class="text-sm text-gray-400">Estado</p>
              <p id="estadoResult" class="font-semibold"></p>
            </div>

            <div>
              <p class="text-sm text-gray-400">Fecha de registro</p>
              <p id="fechaResult" class="text-white"></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>

<script>
  //Cambiar el formulario de acuerdo a lo que seleccione el usuario: presentar queja o ver estatus a traves de folio
  const btnRegister = document.getElementById("btnRegister");
  const btnSearch = document.getElementById("btnSearch");

  const registerSection = document.getElementById("registerSection");
  const searchSection = document.getElementById("searchSection");

  btnRegister.addEventListener("click", () => {
    registerSection.classList.remove("hidden");
    searchSection.classList.add("hidden");

    btnRegister.classList.add("bg-primary", "text-white");
    btnRegister.classList.remove("text-gray-300");

    btnSearch.classList.remove("bg-primary", "text-white");
    btnSearch.classList.add("text-gray-300");
  });

  btnSearch.addEventListener("click", () => {
    searchSection.classList.remove("hidden");
    registerSection.classList.add("hidden");

    btnSearch.classList.add("bg-primary", "text-white");
    btnSearch.classList.remove("text-gray-300");

    btnRegister.classList.remove("bg-primary", "text-white");
    btnRegister.classList.add("text-gray-300");
  });

  const form = document.getElementById("complaintsForm");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const datos = new FormData(form);

    const respuesta = await fetch("http://wisp-api.test/guardar_queja.php", {
      method: "POST",
      body: datos,
    });

    const resultado = await respuesta.json();

    if (resultado.success) {
      alert(`Tu folio es: ${resultado.folio}`);

      // Limpiar formulario
      form.reset();
    } else {
      alert(resultado.message);
    }
  });

  //Buscar por folio
  const searchForm = document.getElementById("searchForm");

  searchForm.addEventListener("submit", async (e) => {
    e.preventDefault();

    const datos = new FormData(searchForm);

    const folio = datos.get("folio");

    const respuesta = await fetch(
      `http://wisp-api.test/consultar_queja.php?folio=${encodeURIComponent(folio)}`,
    );

    const resultado = await respuesta.json();

    if (!respuesta.ok) {
      throw new Error("Error al consultar el servidor.");
    }

    if (!resultado.success) {
      alert(resultado.message);
      return;
    }

    document.getElementById("folioResult").textContent = resultado.data.folio;

    document.getElementById("tipoResult").textContent = resultado.data.tipo;

    document.getElementById("fechaResult").textContent = resultado.data.fecha;

    document.getElementById("searchResult").classList.remove("hidden");
    
     //Cambiar el color de acuerdo al status de la queja
  const estadoResult = document.getElementById("estadoResult");

  estadoResult.textContent = resultado.data.estado;

// Quitar clases anteriores
estadoResult.classList.remove(
  "text-yellow-400",
  "text-blue-400",
  "text-orange-400",
  "text-green-400",
  "text-red-400",
  "text-white"
);

switch (resultado.data.estado) {
  case "Recibida":
    estadoResult.classList.add("text-yellow-400");
    break;

  case "En revisión":
    estadoResult.classList.add("text-blue-400");
    break;

  case "En proceso":
    estadoResult.classList.add("text-orange-400");
    break;

  case "Resuelta":
    estadoResult.classList.add("text-green-400");
    break;

  case "Cancelada":
    estadoResult.classList.add("text-red-400");
    break;

  default:
    estadoResult.classList.add("text-white");
}
  });

</script>
